#!/bin/bash
# Reports the state of an openfortivpn systemd unit using the same
# "Key: value" shape that `fortivpn status` prints, so a single parser in
# Model.js serves both backends and neither one needs a special case.
#
# Usage: openfortivpn-status <unit> [--check]
#        openfortivpn-status --list
#   --check  print nothing; exit 0 only if the unit is actually usable.
#   --list   print every profile as "<name><TAB><saml-url>", one per line.
#
# An "Error:" line carries the reason a tunnel cannot come up, so the panel can
# say what is wrong instead of leaving a click with no visible effect.

set -uo pipefail

# Overridable so the self-check can point discovery at a fixture directory.
conf_dir="${OPENFORTIVPN_DIR:-/etc/openfortivpn}"

# A profile config is mode 600, so the widget running as the user cannot read
# the gateway out of it. The systemd drop-in is world readable, which is why
# setup-openfortivpn records the login URL there instead.
saml_url_for() {
	systemctl show -p Environment --value "$1" 2>/dev/null |
		tr ' ' '\n' | sed -n 's/^FORTIVPN_SAML_URL=//p' | head -1
}

# Every <name>.conf in the directory is a profile; "config" and the certificate
# bundles that live beside them are not, and the glob already excludes them.
if [[ "${1:-}" == "--list" ]]; then
	for conf in "$conf_dir"/*.conf; do
		[[ -e "$conf" ]] || continue
		name="$(basename "$conf" .conf)"
		printf '%s\t%s\n' "$name" "$(saml_url_for "openfortivpn@${name}.service")"
	done
	exit 0
fi

unit="${1:-openfortivpn@vpn}"
[[ "$unit" == *.service ]] || unit="${unit}.service"
mode="${2:-}"

instance="${unit#openfortivpn@}"
instance="${instance%.service}"

# systemd resolves openfortivpn@anything.service from the packaged template, so
# `systemctl cat` succeeds even for a profile that was never created. The real
# question is whether the config the unit will read actually exists.
conf="$(systemctl show -p ExecStart --value "$unit" 2>/dev/null |
	grep -oE '/etc/openfortivpn/[^ ";]+\.conf' | head -1)"
[[ -n "$conf" ]] || conf="${conf_dir}/${instance}.conf"

if [[ "$mode" == "--check" ]]; then
	systemctl cat "$unit" >/dev/null 2>&1 || exit 1
	[[ -e "$conf" ]] || exit 1
	exit 0
fi

active="$(systemctl is-active "$unit" 2>/dev/null)"
case "$active" in
	active)       state="Connected" ;;
	activating)   state="Connecting" ;;
	deactivating) state="Disconnected" ;;
	*)            state="Not Running" ;;
esac

echo "Status: ${state}"

if [[ "$state" != "Connected" ]]; then
	# Say why, when there is a why. A missing profile is the common one and is
	# otherwise invisible: the unit simply refuses to start.
	if [[ ! -e "$conf" ]]; then
		echo "Error: Profile ${instance} has no config at ${conf}"
	elif [[ "$active" == "failed" ]]; then
		# Said the way a person would say it, because this line is the whole
		# explanation the panel gets to show. The raw systemd result survives only
		# where there is nothing better to say.
		result="$(systemctl show -p Result --value "$unit" 2>/dev/null)"
		case "$result" in
			start-limit-hit) echo "Error: Too many failed starts. Connecting again clears it and retries." ;;
			timeout)         echo "Error: The login took too long and the tunnel gave up." ;;
			exit-code)       echo "Error: The last connection attempt failed. Check the gateway, then try again." ;;
			*)               echo "Error: The tunnel stopped unexpectedly (${result:-unknown})." ;;
		esac
	fi
	exit 0
fi

# openfortivpn@work.service -> "work", which is the profile the user named.
echo "VPN name: ${instance}"

# Whichever ppp device openfortivpn brought up; the number is not stable.
iface="$(ip -o link show type ppp 2>/dev/null | awk -F': ' 'NR==1 {print $2}')"
[[ -n "$iface" ]] || exit 0

ip4="$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk 'NR==1 {print $4}' | cut -d/ -f1)"
[[ -n "$ip4" ]] && echo "IP: ${ip4}"

tx="$(cat "/sys/class/net/${iface}/statistics/tx_bytes" 2>/dev/null)"
rx="$(cat "/sys/class/net/${iface}/statistics/rx_bytes" 2>/dev/null)"
[[ -n "$tx" ]] && echo "Sent bytes: ${tx}"
[[ -n "$rx" ]] && echo "Recv bytes: ${rx}"

# systemd already records when the unit went active, so the tunnel's age comes
# free rather than needing state of our own. Both clocks are CLOCK_MONOTONIC.
since="$(systemctl show -p ActiveEnterTimestampMonotonic --value "$unit" 2>/dev/null)"
if [[ -n "$since" && "$since" != "0" ]]; then
	now="$(awk '{printf "%d", $1 * 1000000}' /proc/uptime)"
	secs=$(( (now - since) / 1000000 ))
	if (( secs >= 0 )); then
		printf 'Duration: %02d:%02d:%02d\n' \
			$(( secs / 3600 )) $(( secs % 3600 / 60 )) $(( secs % 60 ))
	fi
fi
